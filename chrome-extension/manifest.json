{
  "manifest_version": 3,
  "name": "Wantry — Add to Wishlist",
  "short_name": "Wantry",
  "version": "1.0.0",
  "description": "Quickly add products from any page to your Wantry wishlist with AI-powered extraction.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Add to Wantry"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://wantry.vercel.app/*",
    "http://localhost:3000/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wantry.vercel.app/auth/extension*",
        "http://localhost:3000/auth/extension*"
      ],
      "js": ["auth-content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://wantry.vercel.app/*",
      "http://localhost:3000/*"
    ]
  }
}
